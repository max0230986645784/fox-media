# Serveur de licences Fox Media — copie ce fichier en .env et remplis les valeurs.
# Ne commite jamais le .env.

# Genere avec: npm run licence:keys
LICENCE_PRIVATE_KEY=
# Secret aleatoire (ex: openssl rand -base64 32)
TOKEN_SECRET=
# Mot de passe d'acces aux routes d'administration
ADMIN_TOKEN=

# Envoi des cles par email (Brevo, expediteur verifie dans Brevo)
BREVO_API_KEY=
FROM_EMAIL=Fox Media <foxmedia.pub@hotmail.com>
# Alternative si Brevo n'est pas utilise
RESEND_API_KEY=

# URL publique du serveur une fois heberge
PUBLIC_URL=

# Paiement (optionnel)
STRIPE_SECRET_KEY=
