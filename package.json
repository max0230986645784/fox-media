{
  "name": "fox-media",
  "productName": "Fox Media",
  "description": "Lecteur local de films, séries et musiques (MP4/MP3) pour PC et téléphone",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icon": "node scripts/make-icon.mjs",
    "site": "npm run build && node scripts/build-site.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "ffmpeg:win": "node scripts/fetch-ffmpeg.mjs win32",
    "ffmpeg:linux": "node scripts/fetch-ffmpeg.mjs linux",
    "dist:linux": "npm run build && npm run ffmpeg:linux && electron-builder --linux",
    "dist:win": "npm run build && npm run ffmpeg:win && electron-builder --win",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "licence:keys": "node scripts/licence-keys.mjs",
    "licence:issue": "node scripts/issue-key.mjs",
    "licence:server": "node --env-file-if-exists=.env server/licence-server.mjs",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "android:apk:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "app.foxmedia.player",
    "productName": "Fox Media",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "resources/win/ffmpeg.exe",
          "to": "ffmpeg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "max0230986645784",
        "repo": "fox-media"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "resources/linux/ffmpeg",
          "to": "ffmpeg"
        }
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
