{
  "name": "nox-booster",
  "productName": "Nox Booster",
  "description": "Booster réseau + FPS pour PC gaming : ping plus bas, connexion stable, téléchargements plus rapides",
  "private": true,
  "version": "1.0.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "icon": "python3 scripts/make-icon.py",
    "dist:win": "electron-builder --win",
    "lint": "node --check main.cjs && node --check booster.cjs && node --check preload.cjs && node --check ui/app.js"
  },
  "build": {
    "appId": "app.noxbooster.pc",
    "productName": "Nox Booster",
    "files": [
      "main.cjs",
      "preload.cjs",
      "booster.cjs",
      "ui/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "artifactName": "NoxBooster-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "max0230986645784",
      "repo": "fox-media",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
